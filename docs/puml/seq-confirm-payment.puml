@startuml
title Sequence - Confirm Payment (POST /payments/{paymentId}/confirm)

actor Client
participant "PaymentController" as Controller
participant "PaymentService" as Service
participant "PaymentRepository" as PaymentRepo
participant "GlobalExceptionHandler" as ErrorHandler
database "PostgreSQL" as DB

Client -> Controller : POST /payments/{paymentId}/confirm
Controller -> Service : confirmPayment(paymentId)
Service -> PaymentRepo : findById(paymentId)
PaymentRepo -> DB : SELECT payment by id
DB --> PaymentRepo : payment row / empty

alt Payment not found
  PaymentRepo --> Service : empty
  Service --> Controller : NotFoundException(payment)
  Controller -> ErrorHandler : handle(NotFoundException)
  ErrorHandler --> Client : HTTP 404 Not Found
else Payment found
  PaymentRepo --> Service : Payment(status)

  alt status == PENDING
    Service -> Service : set status = CONFIRMED
    Service -> PaymentRepo : save(payment)
    PaymentRepo -> DB : UPDATE payment status
    DB --> PaymentRepo : row updated
    PaymentRepo --> Service : Payment(CONFIRMED)
    Service --> Controller : StatusResponse
    Controller --> Client : HTTP 200\n{paymentId, status=CONFIRMED}
  else status == CONFIRMED or CANCELED
    Service --> Controller : InvalidStateException
    Controller -> ErrorHandler : handle(InvalidStateException)
    ErrorHandler --> Client : HTTP 400 Bad Request
  end
end

@enduml
